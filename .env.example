# ============================================================
# คัดลอกไฟล์นี้เป็นชื่อ .env แล้วแก้รหัสผ่านทุกตัวก่อนใช้งานจริง
#   cp .env.example .env
#
# ไฟล์ .env จะไม่ถูก commit เข้า git และไม่ถูก build เข้า docker image
# (ดู .gitignore และ .dockerignore) และเว็บเซิร์ฟเวอร์ปฏิเสธการเข้าถึงไฟล์นี้
# โดยตรงผ่าน URL อยู่แล้ว (ดู .htaccess ที่รากโปรเจค)
# ============================================================

# รหัสผ่าน root ของ MySQL — ใช้เฉพาะตอน container สร้างฐานข้อมูลครั้งแรก และตอนต้องแก้ไขโครงสร้างตาราง
# เว็บแอปไม่เคยใช้บัญชีนี้เชื่อมต่อเลย
DB_ROOT_PASSWORD=ChangeThisRootPassword!456

# ฐานข้อมูลและบัญชีที่เว็บแอปใช้เชื่อมต่อจริง (สิทธิ์จำกัดแบบ Least Privilege)
DB_NAME=sheetapp_db
DB_USER=sheetapp_user
DB_PASSWORD=ChangeThisPassword!123

# ใช้เข้ารหัสข้อมูลใน cookie ของ phpMyAdmin (ตั้งได้ทุกค่า แต่ควรเป็นสตริงสุ่มยาว ๆ ไม่ซ้ำใคร)
# สร้างค่าใหม่ได้ด้วยคำสั่ง: openssl rand -base64 32
PMA_BLOWFISH_SECRET=please_change_this_to_a_random_32_char_string
